# Copy to .env and fill in for your environment. .env is ignored by git.
# Only public values belong here: the project URL and the publishable key.
# Never put a secret key (sb_secret_...), service_role key or database password
# in any EXPO_PUBLIC_ variable: Expo builds these into the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
